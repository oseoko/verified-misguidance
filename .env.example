# CiteTrace environment variables
#
# These are needed only if you run the full data-generation pipeline
# (s02_search, s03_judge), which calls external LLM APIs. For paper-table
# reproduction from the released HF dataset (the recommended reviewer
# path), no keys are needed.
#
# Copy this to .env and fill in real values. Never commit .env.

# ── LLM API keys (only required for s02_search / s03_judge) ────────────────
# Each provider key is needed only if you call models from that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=
